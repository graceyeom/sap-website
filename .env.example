# Supabase 환경변수 (Vite는 VITE_ 접두사가 붙은 변수만 클라이언트에 노출)
# Supabase Dashboard → Project Settings → API에서 복사
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Railway에서는 PORT를 자동으로 주입 (로컬은 기본 3000)
# PORT=3000

# 스티비(Stibee) 사전신청 연동 — 서버에서만 사용 (VITE_ 접두사 없음 = 클라이언트에 노출 안 됨)
# 스티비 → 워크스페이스 설정 → API 키 에서 발급
STIBEE_API_KEY=your-stibee-api-key
# 구독자를 추가할 주소록(리스트) ID. 스티비 주소록 URL의 숫자 부분
STIBEE_LIST_ID=your-list-id
